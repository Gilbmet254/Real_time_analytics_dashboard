{
  "name": "EventStream",
  "type": "object",
  "properties": {
    "stream_name": {
      "type": "string",
      "description": "Name of the event stream"
    },
    "source": {
      "type": "string",
      "description": "Source system"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "error",
        "initializing"
      ],
      "default": "active"
    },
    "events_per_minute": {
      "type": "number",
      "default": 0
    },
    "total_events": {
      "type": "number",
      "default": 0
    },
    "avg_latency_ms": {
      "type": "number",
      "default": 0
    },
    "error_rate": {
      "type": "number",
      "default": 0
    },
    "schema_type": {
      "type": "string",
      "enum": [
        "json",
        "avro",
        "protobuf"
      ],
      "default": "json"
    }
  },
  "required": [
    "stream_name",
    "source"
  ]
}